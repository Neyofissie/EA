//@version=6
// ============================================================================
//  SMC Break of Structure + Retest (trend-following) — Chart Indicator
//  Logic:
//   1. Trend filter  : EMA trend and/or market structure (HH+HL / LH+LL),
//                      plus optional higher-timeframe (HTF) EMA bias.
//   2. BOS           : candle CLOSES beyond the last confirmed swing high (bull)
//                      or swing low (bear) IN THE DIRECTION OF THE TREND.
//   3. Retest        : within N bars price pulls back into the broken level
//                      (± ATR tolerance) and closes back on the right side,
//                      optionally with a rejection candle -> SIGNAL.
//   4. Risk          : SL beyond the retest wick/level + ATR buffer, TP at R:R.
//  Setup is cancelled if price closes back through the level or it times out.
// ============================================================================
indicator("SMC BOS + Retest [Trend]", shorttitle = "SMC BOS-R", overlay = true, max_lines_count = 500, max_labels_count = 500)

// ---------------- Inputs ----------------
grpS = "Structure"
swingLen   = input.int(5, "Swing length (pivot left/right bars)", minval = 1, group = grpS)
grpT = "Trend filter"
trendMode  = input.string("EMA + Structure", "Trend filter", options = ["EMA", "Structure", "EMA + Structure", "None"], group = grpT)
emaLen     = input.int(200, "Trend EMA length", minval = 2, group = grpT)
useHtf     = input.bool(true, "Require higher-timeframe bias", group = grpT)
htfTf      = input.timeframe("240", "HTF timeframe", group = grpT)
htfEmaLen  = input.int(50, "HTF EMA length", minval = 2, group = grpT)
grpR = "Retest"
tolAtr     = input.float(0.25, "Retest tolerance (x ATR)", minval = 0, step = 0.05, group = grpR)
maxRetest  = input.int(20, "Max bars to wait for retest", minval = 1, group = grpR)
needRej    = input.bool(true, "Require rejection candle (close in trend direction)", group = grpR)
grpK = "Risk"
slAtr      = input.float(0.5, "SL buffer (x ATR)", minval = 0, step = 0.1, group = grpK)
rr         = input.float(2.0, "Take-profit R:R", minval = 0.1, step = 0.1, group = grpK)
grpV = "Display"
showEma    = input.bool(true, "Show trend EMA", group = grpV)
showBos    = input.bool(true, "Show BOS levels", group = grpV)
showRisk   = input.bool(true, "Show SL / TP lines", group = grpV)
showPanel  = input.bool(true, "Show status panel", group = grpV)

// ---------------- Core engine (same as scanner) ----------------
smcCore(swingLen, emaLen, trendMode, tolAtr, maxRetest, rr, slAtr, needRej) =>
    atr = ta.atr(14)
    ema = ta.ema(close, emaLen)
    emaRising  = ema > ema[3]
    emaFalling = ema < ema[3]
    ph = ta.pivothigh(high, swingLen, swingLen)
    pl = ta.pivotlow(low, swingLen, swingLen)

    var float lastH    = na
    var float prevH    = na
    var int   lastHBar = na
    var bool  hBroken  = true
    var float lastL    = na
    var float prevL    = na
    var int   lastLBar = na
    var bool  lBroken  = true

    if not na(ph)
        prevH    := lastH
        lastH    := ph
        lastHBar := bar_index - swingLen
        hBroken  := false
    if not na(pl)
        prevL    := lastL
        lastL    := pl
        lastLBar := bar_index - swingLen
        lBroken  := false

    haveStruct = not na(prevH) and not na(prevL)
    structUp = haveStruct and lastH > prevH and lastL > prevL
    structDn = haveStruct and lastH < prevH and lastL < prevL
    emaUp = close > ema and emaRising
    emaDn = close < ema and emaFalling
    trendUp = switch trendMode
        "EMA"             => emaUp
        "Structure"       => structUp
        "EMA + Structure" => emaUp and structUp
        => true
    trendDn = switch trendMode
        "EMA"             => emaDn
        "Structure"       => structDn
        "EMA + Structure" => emaDn and structDn
        => true
    int trendDir = trendUp and not trendDn ? 1 : trendDn and not trendUp ? -1 : 0

    var int   state  = 0      // 1 = bull BOS waiting retest, -1 = bear BOS waiting retest
    var float lvl    = na
    var int   lvlBar = na
    var int   bosBar = na
    var int   lastSig     = 0
    var float lastEntry   = na
    var float lastSL      = na
    var float lastTP      = na
    var int   lastSigTime = na
    var int   lastSigBar  = na

    tol = atr * tolAtr
    int   sig = 0
    float sl  = na
    float tp  = na

    // --- manage a pending retest ---
    if state == 1
        if close < lvl - tol or bar_index - bosBar > maxRetest
            state := 0
        else if bar_index > bosBar and low <= lvl + tol and close > lvl and (not needRej or close > open)
            sig   := 1
            sl    := math.min(low, lvl) - slAtr * atr
            tp    := close + rr * (close - sl)
            state := 0
    else if state == -1
        if close > lvl + tol or bar_index - bosBar > maxRetest
            state := 0
        else if bar_index > bosBar and high >= lvl - tol and close < lvl and (not needRej or close < open)
            sig   := -1
            sl    := math.max(high, lvl) + slAtr * atr
            tp    := close - rr * (sl - close)
            state := 0

    if sig != 0
        lastSig     := sig
        lastEntry   := close
        lastSL      := sl
        lastTP      := tp
        lastSigTime := time
        lastSigBar  := bar_index

    // --- detect a new break of structure (with the trend) ---
    int bosEvt = 0
    if not hBroken and not na(lastH) and close > lastH
        hBroken := true
        if trendUp
            bosEvt := 1
            state  := 1
            lvl    := lastH
            lvlBar := lastHBar
            bosBar := bar_index
    if not lBroken and not na(lastL) and close < lastL
        lBroken := true
        if trendDn
            bosEvt := -1
            state  := -1
            lvl    := lastL
            lvlBar := lastLBar
            bosBar := bar_index

    int barsSince = na(lastSigBar) ? na : bar_index - lastSigBar
    [sig, state, trendDir, lvl, lvlBar, bosEvt, sl, tp, ema, lastSig, barsSince]

// ---------------- Run ----------------
[sig, state, trendDir, lvl, lvlBar, bosEvt, sl, tp, ema, lastSig, barsSince] = smcCore(swingLen, emaLen, trendMode, tolAtr, maxRetest, rr, slAtr, needRej)

htfBiasFn() =>
    b = close > ta.ema(close, htfEmaLen) ? 1 : -1
    b[1]
int htfRaw = request.security(syminfo.tickerid, htfTf, htfBiasFn(), lookahead = barmerge.lookahead_on)
int htf = useHtf ? htfRaw : 0

buy  = sig == 1  and (not useHtf or htf == 1)
sell = sig == -1 and (not useHtf or htf == -1)

// ---------------- Drawing ----------------
plot(showEma ? ema : na, "Trend EMA", color = trendDir == 1 ? color.teal : trendDir == -1 ? color.maroon : color.gray, linewidth = 2)

if showBos and bosEvt != 0
    c = bosEvt == 1 ? color.teal : color.maroon
    line.new(lvlBar, lvl, bar_index, lvl, color = c, style = line.style_dashed, width = 1)
    label.new(bar_index, lvl, "BOS", style = bosEvt == 1 ? label.style_label_down : label.style_label_up, color = color.new(c, 100), textcolor = c, size = size.tiny)

plotshape(buy,  "Buy (retest)",  shape.triangleup,   location.belowbar, color.lime, size = size.small, text = "BUY")
plotshape(sell, "Sell (retest)", shape.triangledown, location.abovebar, color.red,  size = size.small, text = "SELL")

if showRisk and (buy or sell)
    line.new(bar_index, sl, bar_index + 15, sl, color = color.red,  width = 2)
    line.new(bar_index, tp, bar_index + 15, tp, color = color.lime, width = 2)
    line.new(bar_index, close, bar_index + 15, close, color = color.gray, style = line.style_dotted)

// Hidden plots (Data Window / Pine Screener friendly): 1 buy, -1 sell, 0 none
plot(buy ? 1 : sell ? -1 : 0, "Signal", display = display.data_window)
plot(state, "Pending BOS (1/-1)", display = display.data_window)
plot(trendDir, "Trend (1/-1)", display = display.data_window)

// ---------------- Status panel ----------------
var table panel = table.new(position.top_right, 2, 4, bgcolor = color.new(color.black, 20), border_width = 1)
dirTxt(d) => d == 1 ? "UP" : d == -1 ? "DOWN" : "NEUTRAL"
dirCol(d) => d == 1 ? color.teal : d == -1 ? color.maroon : color.gray
if showPanel and barstate.islast
    table.cell(panel, 0, 0, "Trend",  text_color = color.white, text_size = size.small)
    table.cell(panel, 1, 0, dirTxt(trendDir), bgcolor = dirCol(trendDir), text_color = color.white, text_size = size.small)
    table.cell(panel, 0, 1, "HTF " + htfTf, text_color = color.white, text_size = size.small)
    table.cell(panel, 1, 1, useHtf ? dirTxt(htf) : "off", bgcolor = useHtf ? dirCol(htf) : color.gray, text_color = color.white, text_size = size.small)
    table.cell(panel, 0, 2, "Setup",  text_color = color.white, text_size = size.small)
    table.cell(panel, 1, 2, state == 1 ? "Bull BOS - wait retest" : state == -1 ? "Bear BOS - wait retest" : "None", text_color = color.white, text_size = size.small)
    table.cell(panel, 0, 3, "Last signal", text_color = color.white, text_size = size.small)
    table.cell(panel, 1, 3, lastSig == 0 ? "-" : (lastSig == 1 ? "BUY " : "SELL ") + str.tostring(barsSince) + " bars ago", text_color = color.white, text_size = size.small)

// ---------------- Alerts ----------------
alertcondition(buy,  "SMC Buy (BOS retest)",  "{{ticker}} {{interval}}: SMC BUY – bullish BOS retest @ {{close}}")
alertcondition(sell, "SMC Sell (BOS retest)", "{{ticker}} {{interval}}: SMC SELL – bearish BOS retest @ {{close}}")
alertcondition(bosEvt != 0, "SMC BOS (setup armed)", "{{ticker}} {{interval}}: BOS with trend – watching for retest")
if buy or sell
    alert(syminfo.ticker + " " + timeframe.period + (buy ? " BUY" : " SELL") + " | entry " + str.tostring(close, format.mintick) + " | SL " + str.tostring(sl, format.mintick) + " | TP " + str.tostring(tp, format.mintick), alert.freq_once_per_bar_close)
